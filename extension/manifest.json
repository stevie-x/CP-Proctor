{
  "manifest_version": 3,
  "name": "CP Proctor",
  "version": "1.0",
  "description": "Real-time proctoring for competitive programming platforms",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CP Proctor"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "login.html", "login.js", "supabase.js",
        "reset-password.html", "reset-password.js",
        "dashboard.html", "dashboard.js",
        "webcam.html", "webcam.js", "face-api.min.js",
        "models/tiny_face_detector_model-weights_manifest.json",
        "models/tiny_face_detector_model-shard1",
        "models/face_landmark_68_tiny_model-weights_manifest.json",
        "models/face_landmark_68_tiny_model-shard1"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}